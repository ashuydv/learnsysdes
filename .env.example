# Local Postgres, started with `docker compose up -d`
DATABASE_URL="postgresql://learnsysdes:learnsysdes@localhost:5433/learnsysdes?schema=public"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# OAuth providers — leave blank to disable that provider.
# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# GitHub: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
